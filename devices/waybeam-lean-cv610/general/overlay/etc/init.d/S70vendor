#!/bin/sh

case "$1" in
	start)
		# The encoder's own loader (load-cv610-online, from S95waybeam) loads
		# the CV610 modules with its sensor clock and audio set.
		if [ -x /usr/bin/load-cv610-online ]; then
			echo "Skipping vendor modules: S95waybeam loads them"
			exit 0
		fi
		echo "Loading vendor modules..."
		vendor=$(ipcinfo -v)
		# A family whose drivers are all built into the kernel ships no
		# load script; say so rather than "load_<vendor>: not found".
		if command -v load_"$vendor" >/dev/null; then
			load_"$vendor" -i
		else
			echo "No load_$vendor on this image, nothing to load"
		fi
		;;

	stop)
		;;

	*)
		echo "Usage: $0 {start}"
		exit 1
		;;
esac
